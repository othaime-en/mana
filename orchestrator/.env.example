# PORT Configuration
PORT=8000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty only for local development; set it in every shared environment
REDIS_PASSWORD=
# Set REDIS_TLS=true when Redis terminates TLS (managed Redis, a TLS sidecar)
REDIS_TLS=false
REDIS_TLS_CA_FILE=

# Retry Configuration
MAX_RETRIES=3

# Exponential Backoff Configuration
INITIAL_BACKOFF=10.0
MAX_BACKOFF=300.0
BACKOFF_MULTIPLIER=2.0

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_PORT=5000
HEALTH_CHECK_PATH=/health

# Authentication (the service refuses to start without these)
# Generate with: openssl rand -hex 32. Several comma-separated values are accepted
# so a secret can be rotated without downtime.
WEBHOOK_SECRET=
API_KEY=
# Local development only: disables every authentication check
AUTH_DISABLED=false

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_AUDIT_LOGGING=true

# GitHub Integration (REQUIRED for retry mechanism)
# Generate token at: https://github.com/settings/tokens
# Required permissions: repo, actions
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=yourusername/mana