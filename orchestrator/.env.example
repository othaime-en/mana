# PORT Configuration
PORT=8000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty only for local development; set it in every shared environment
REDIS_PASSWORD=
# Set REDIS_TLS=true when Redis terminates TLS (managed Redis, a TLS sidecar)
REDIS_TLS=false
REDIS_TLS_CA_FILE=

# Retry Configuration
MAX_RETRIES=3

# Exponential Backoff Configuration
INITIAL_BACKOFF=10.0
MAX_BACKOFF=300.0
BACKOFF_MULTIPLIER=2.0

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_PORT=5000
HEALTH_CHECK_PATH=/health

# Authentication (the service refuses to start without these)
# Generate with: openssl rand -hex 32. Several comma-separated values are accepted
# so a secret can be rotated without downtime.
WEBHOOK_SECRET=
API_KEY=
# Local development only: disables every authentication check
AUTH_DISABLED=false

# Job scheduler: retries, rollbacks and alerts run as durable jobs in Redis
JOB_LEASE_SECONDS=60
SCHEDULER_POLL_SECONDS=1
SCHEDULER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=5
SHUTDOWN_GRACE_SECONDS=30

# Alerts (optional). Slack incoming webhook; https only.
SLACK_WEBHOOK_URL=
# Mark the commit with a mana/recovery status (needs GITHUB_TOKEN, GITHUB_REPO and
# commit-status write access on the token)
ALERT_GITHUB_STATUS=true

# Recovery policy (optional). Without POLICY_FILE the built-in policy is used; see
# policy.example.yaml and docs/configuration/recovery-policy.md. MAX_RETRIES caps its retries.
POLICY_FILE=
# How often a rollout is checked while a rollback is verified (seconds)
HEALTH_POLL_SECONDS=5

# Cluster-side detection of stuck rollouts (Deployments labelled mana.io/managed=true)
WATCHER_ENABLED=false
WATCHER_NAMESPACES=production,staging
WATCHER_INTERVAL_SECONDS=15
WATCHER_STUCK_SECONDS=120

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_AUDIT_LOGGING=true

# GitHub Integration (REQUIRED for retry mechanism)
# Generate token at: https://github.com/settings/tokens
# Required permissions: repo, actions
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=yourusername/mana